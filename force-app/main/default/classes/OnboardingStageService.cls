public class OnboardingStageService {
    private static final List<String> STAGES = new List<String>{
        'Kickoff Scheduled',
        'Gathering Info',
        'Implementation',
        'QA / Review',
        'Go Live',
        'Post-Launch Review'
    };

    private static final List<String> TIMESTAMP_FIELDS = new List<String>{
        'Kickoff_First_Reached__c',
        'Gathering_First_Reached__c',
        'Implementation_First_Reached__c',
        'QA_First_Reached__c',
        'Go_Live_First_Reached__c',
        'Post_Launch_First_Reached__c'
    };

    public static void applyRules(
        List<Onboarding__c> records,
        Map<Id, Onboarding__c> oldMap
    ) {
        Datetime reachedAt = System.now();

        for (Onboarding__c record : records) {
            Onboarding__c previous =
                oldMap == null ? null : oldMap.get(record.Id);

            if (previous == null && String.isBlank(record.Stage__c)) {
                record.Stage__c = STAGES[0];
            }

            Integer newIndex = STAGES.indexOf(record.Stage__c);

            if (newIndex < 0) {
                record.addError('Select a valid onboarding stage.');
                continue;
            }

            if (previous == null) {
                if (newIndex != 0) {
                    record.addError(
                        'New onboardings must start at Kickoff Scheduled.'
                    );
                    continue;
                }

                // Historical timestamps are generated by this service.
                for (String fieldName : TIMESTAMP_FIELDS) {
                    record.put(fieldName, null);
                }
            } else {
                // Restore historical values even if an API caller edits them.
                for (String fieldName : TIMESTAMP_FIELDS) {
                    record.put(fieldName, previous.get(fieldName));
                }

                Integer oldIndex = STAGES.indexOf(previous.Stage__c);

                Boolean stageChanged =
                    record.Stage__c != previous.Stage__c;

                Boolean nextStage = newIndex == oldIndex + 1;

                Boolean failedQA =
                    previous.Stage__c == 'QA / Review' &&
                    record.Stage__c == 'Implementation';

                if (stageChanged && !nextStage && !failedQA) {
                    record.addError(
                        'Move forward one stage at a time. Only QA / Review ' +
                        'can move back to Implementation.'
                    );
                    continue;
                }
            }

            if (
                newIndex >= 2 &&
                String.isBlank(record.Gathering_Notes__c)
            ) {
                record.addError(
                    'Enter Gathering Notes before entering Implementation ' +
                    'or a later stage.'
                );
            }

            if (
                newIndex >= 3 &&
                String.isBlank(record.Implementation_Notes__c)
            ) {
                record.addError(
                    'Enter Implementation Notes before entering QA / Review ' +
                    'or a later stage.'
                );
            }

            String timestampField = TIMESTAMP_FIELDS[newIndex];

            if (record.get(timestampField) == null) {
                record.put(timestampField, reachedAt);
            }
        }
    }
}